{
  "name": "0jimbox",
  "image": "0jimbox",

  // Pass the Docker-format secrets file directly + use host networking for corporate firewall
  "runArgs": [
    "--env-file", "${localEnv:HOME}/.secrets/dotfiles_docker.env",
    "--network=host"
  ],

  // Mount assets directory for auto-refreshed AWS credentials
  "mounts": [
    "source=${localEnv:HOME}/assets,target=/home/vscode/assets,type=bind,readonly"
  ],

  // Restore SSH and GPG keys after dotfiles installation. Needs DOTFILES_KEY and sops.
  "postAttachCommand": "~/.config/dotfiles/scripts/keys.sh init && ~/.config/dotfiles/scripts/keys.sh restore",

  // tiny hack to make sure the first terminal is a fully configured shell
  "features": {
    "./features/fix-zsh": {}
  }
}
